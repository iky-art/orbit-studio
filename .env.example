# Firebase (opsional). Biarkan kosong untuk MODE DEMO.
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# Ambil dari Firebase Console → Project settings → Your apps → Web app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Email kontak yang tampil di halaman legal (Syarat, Privasi, Cookie).
VITE_CONTACT_EMAIL=
