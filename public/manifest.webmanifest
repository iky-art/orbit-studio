{
  "id": "/app",
  "name": "Orbit Studio — Workbench",
  "short_name": "Orbit Studio",
  "description": "Workbench analitik dengan panel admin lengkap dan pengaturan mendalam. Pasang dari browser, langsung jadi aplikasi.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#17191c",
  "theme_color": "#17191c",
  "categories": ["productivity", "business", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Beranda", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Aktivitas", "url": "/app/activity", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "/app/insights", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Panel admin", "url": "/app/admin", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
